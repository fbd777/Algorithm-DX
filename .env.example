# Copy to .env in the project root. .env is loaded by the CLI and ignored by Git.
ALGO_DB_PATH=data/algo-observer.sqlite
ALGO_DASHBOARD_PORT=8787

# Login credentials are keyed by PLATFORM, not by account: one Cookie reads every
# public account on that platform, including people you watch, so watching another
# account never needs another credential. The legacy ALGO_COOKIE_<local account ID>
# form still works but is no longer what you should write for new setups.
#
# For Luogu you only need two keys, not the whole Cookie header:
#   __client_id  the actual credential - keep it secret
#   _uid         your numeric user id; public, only a self-declaration
#
# One Cookie covers every Luogu account, so use the platform form even when you
# observe several people:
# ALGO_COOKIE_LUOGU="__client_id=…; _uid=YOUR_LUOGU_UID"
# ALGO_COOKIE_MATIJI="your own Matiji Cookie"
# LeetCode China is an exception: history belongs ONLY to the cookie owner.
# The bound /u/<slug>/ must match that owner. Public recent AC needs no cookie.
# ALGO_COOKIE_LEETCODE_CN="LEETCODE_SESSION=…; csrftoken=…"
#
# You can skip manual editing: `account add <userId> luogu <uid> --cookie "<value>"`
# updates this file in place. Credentials containing quotes or line breaks are
# rejected, because a line break would inject an unrelated variable into .env.
#
# Keep the value local; do not paste it into chat or commit it.

# Legacy Matiji snapshot override. Omit this to use live sync with the shared Cookie.
# Replace 123 with your local account ID from account list.
# ALGO_MATIJI_SNAPSHOT_123=data/matiji-records.json

# Optional Codeforces Group contests (configure in dashboard)
# ALGO_CF_API_KEY=
# ALGO_CF_API_SECRET=
# ALGO_CF_GROUPS_1=https://codeforces.com/group/GROUP/contest/123456

# CF Group 默认使用普通 Edge 扩展；可选 browser（专用浏览器）/ api 模式
# ALGO_CF_GROUP_MODE_1=extension
# 可选：Edge / Chrome / Chromium 可执行文件绝对路径
# ALGO_CF_BROWSER_EXECUTABLE=
